# Copy to .env and fill in. NEVER commit .env or your SSH key.

# ---- Phoenix ERP mock (URL + your team token are on Builder Base) ----
PHOENIX_API_BASE_URL=https://REPLACE-with-the-phoenix-url-from-builder-base
PHOENIX_API_TOKEN=replace-with-your-team-token

# ---- SSH access to the customer VMs ----
# Put your .pem in ./keys/ (mounted read-only at /keys) and point this at it.
SSH_PRIVATE_KEY_PATH=/keys/your-key.pem
SSH_USERNAME=azureuser

# ---- LLM provider (ADR-0010) ----
# The model layer is model-agnostic behind the llm.complete_json() seam, built on
# LangChain. Pick a provider; the backend builds the matching chat model from these.
#   azure-openai (default) -> ChatOpenAI(base_url={endpoint}/openai/v1/)  [Azure values below]
#   ollama                 -> ChatOllama(base_url=OLLAMA_BASE_URL, format="json")
LLM_PROVIDER=azure-openai
# LLM_MODEL: the fast model — empty falls back to AZURE_OPENAI_DEPLOYMENT for azure-openai; REQUIRED for ollama.
LLM_MODEL=
# Two-tier routing (ADR-0011): a stronger model for ALL in-loop reasoning (diagnosis +
# planning); the fast model only drafts the activity log. Empty -> no routing.
# LLM_REASONING_MODEL=gpt-5.4
# Local Ollama example (uncomment + set LLM_PROVIDER=ollama + LLM_MODEL=llama3.1 to use):
# OLLAMA_BASE_URL=http://localhost:11434

# ---- LLM: Azure OpenAI (bring-your-own — see ADR-0006) ----
# This is an Azure AI Foundry *project* endpoint; the backend calls the OpenAI-compatible
# v1 API ({endpoint}/openai/v1/) with NO api-version. The classic .openai.azure.com +
# api-version path does NOT work here. Verified: JSON mode works; native tool-calling
# does not reliably fire on gpt-5.4-nano (we use JSON mode).
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.services.ai.azure.com/api/projects/YOUR_PROJECT
AZURE_OPENAI_API_KEY=replace-with-your-azure-openai-key
AZURE_OPENAI_DEPLOYMENT=gpt-5.4-nano
AZURE_OPENAI_API_VERSION=unused-on-v1-path
# Optional embeddings (text-embedding-3-large). Available but UNWIRED — memory is a
# markdown graph (ADR-0001). Set only if you wire semantic recall later.
# AZURE_EMBEDDING_DEPLOYMENT=text-embedding-3-large

# ---- Timeouts & guardrails (sensible defaults; tune as needed) ----
HTTP_TIMEOUT_SECONDS=15
SSH_CONNECT_TIMEOUT=15
SSH_COMMAND_TIMEOUT=60
AGENT_MAX_STEPS=25

# ---- Frontend ----
VITE_API_BASE=http://localhost:8000
