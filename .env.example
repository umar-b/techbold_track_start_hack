# Copy to .env and fill in. NEVER commit .env or your SSH key.

# ---- Phoenix ERP mock (URL + your team token are on Builder Base) ----
PHOENIX_API_BASE_URL=https://REPLACE-with-the-phoenix-url-from-builder-base
PHOENIX_API_TOKEN=replace-with-your-team-token

# ---- SSH access to the customer VMs ----
# Put your .pem in ./keys/ (mounted read-only at /keys) and point this at it.
SSH_PRIVATE_KEY_PATH=/keys/your-key.pem
SSH_USERNAME=azureuser

# ---- LLM: Azure OpenAI (bring your own key) ----
# Use the Azure AI Foundry project endpoint. The backend calls:
#   {endpoint}/openai/v1/
# Do not use the classic api-version path here. The agent uses JSON mode.
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.services.ai.azure.com/api/projects/YOUR_PROJECT
AZURE_OPENAI_API_KEY=replace-with-your-azure-openai-key
AZURE_OPENAI_DEPLOYMENT=gpt-5.4-nano
AZURE_OPENAI_API_VERSION=unused-on-v1-path

# ---- Timeouts & guardrails (sensible defaults; tune as needed) ----
HTTP_TIMEOUT_SECONDS=15
SSH_CONNECT_TIMEOUT=15
SSH_COMMAND_TIMEOUT=60
AGENT_MAX_STEPS=25

# ---- Frontend ----
VITE_API_BASE=http://localhost:8000
